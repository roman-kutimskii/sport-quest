generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportKind {
  ACTIVITY
  BINGO
  STEPS
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AwardType {
  STREAK_3
  STREAK_5
  STREAK_7
}

enum ReportSource {
  WEB
  TELEGRAM
}

enum TelegramLinkStatus {
  RECEIVED
  SKIPPED
  ASKED
  SAVED
  UNDONE
  FAILED
}

enum OutboxKind {
  REPORT_CREATED
  DIGEST
  TEXT
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id             String       @id @default(cuid())
  name           String
  avatarEmoji    String       @default("🏃")
  telegramHandle String?
  telegramId     String?      @unique // OIDC `sub` from Telegram Login
  telegramUserId String?      @unique // numeric Telegram user id (Bot API `from.id`, OIDC `id` claim)
  isAdmin        Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  reports        Report[]
  adjustments    Adjustment[]
  reviewed       Report[]     @relation("Reviewer")
  votesCast      AmbassadorVote[] @relation("Voter")
  votesReceived  AmbassadorVote[] @relation("Candidate")
}

model Quest {
  id          String   @id @default(cuid())
  title       String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  timezone    String   @default("Europe/Moscow")
  autoApprove Boolean  @default(true)
  resultsPublished Boolean @default(false)
  votingOpen  Boolean  @default(false)
  isActive    Boolean  @default(true)
  reports     Report[]
  adjustments Adjustment[]
  nominations NominationResult[]
  ambassadorVotes AmbassadorVote[]
}

model Report {
  id           String       @id @default(cuid())
  userId       String
  questId      String
  kind         ReportKind
  date         DateTime     @db.Date
  activityTypes String[]     @default([])
  bingoKey     String?
  steps        Int?
  comment      String?
  proofUrls    String[]     @default([])
  galleryUrls  String[]     @default([])
  status       ReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  source       ReportSource @default(WEB)
  linkId       String?
  createdAt    DateTime     @default(now())

  user       User          @relation(fields: [userId], references: [id])
  quest      Quest         @relation(fields: [questId], references: [id])
  reviewedBy User?         @relation("Reviewer", fields: [reviewedById], references: [id])
  link       TelegramLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([userId, questId, date])
  @@index([questId, status])
  @@index([linkId])
}

/// One row per processed Telegram group message (or album).
model TelegramLink {
  id             String             @id @default(cuid())
  chatId         String
  messageId      Int
  threadId       Int?
  mediaGroupId   String?
  fromUserId     String
  fromName       String?
  userId         String?
  messageDate    DateTime
  text           String?
  mediaKinds     String[]           @default([])
  update         Json?
  status         TelegramLinkStatus @default(RECEIVED)
  extraction     Json?
  llmRaw         String?
  confidence     Float?
  replyMessageId Int?
  error          String?
  createdAt      DateTime           @default(now())
  processedAt    DateTime?
  reports        Report[]

  @@unique([chatId, messageId])
  @@index([status, createdAt])
  @@index([mediaGroupId])
}

/// Everything the bot sends that is not a direct reply to a message.
model Outbox {
  id        String       @id @default(cuid())
  kind      OutboxKind
  chatId    String?
  threadId  Int?
  payload   Json
  dedupeKey String?      @unique
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

/// Key/value state for the bot worker: getUpdates offset, last digest period, health timestamps.
model BotState {
  key   String @id
  value Json
}

model Adjustment {
  id        String   @id @default(cuid())
  userId    String
  questId   String
  delta     Int
  comment   String
  createdBy String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  quest     Quest    @relation(fields: [questId], references: [id])
}

model NominationResult {
  id          String   @id @default(cuid())
  questId     String
  key         String
  userId      String
  isManual    Boolean  @default(false)
  createdAt   DateTime @default(now())
  quest       Quest    @relation(fields: [questId], references: [id])

  @@unique([questId, key])
}

model AmbassadorVote {
  id          String   @id @default(cuid())
  questId     String
  voterId     String
  candidateId String
  createdAt   DateTime @default(now())
  quest       Quest    @relation(fields: [questId], references: [id])
  voter       User     @relation("Voter", fields: [voterId], references: [id])
  candidate   User     @relation("Candidate", fields: [candidateId], references: [id])

  @@unique([questId, voterId])
  @@index([questId, candidateId])
}
