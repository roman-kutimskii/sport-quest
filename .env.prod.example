DOMAIN=tl-sport.ru
SERVER_IP=
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me
SEED_SAMPLES=0
# Select an already-restored volume for a data cutover; preserve the previous volume for rollback.
UPLOADS_VOLUME=sport-quest_uploads
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Internal Docker service only; never publish its port on the host.
TELEGRAM_PROXY_URL=http://xray:18080
XRAY_US_ADDRESS=
XRAY_US_PORT=2053
XRAY_CLIENT_UUID=
XRAY_REALITY_PUBLIC_KEY=
XRAY_REALITY_SHORT_ID=
XRAY_REALITY_SERVER_NAME=cloudflare.com
TELEGRAM_ADMIN_USERNAMES=
# Telegram group bot (the same BotFather bot as the login; disable privacy mode via /setprivacy or make it a group admin)
TELEGRAM_BOT_TOKEN=
# Numeric group id (negative). Leave empty at first and send /id in the group to get it.
TELEGRAM_GROUP_CHAT_ID=
# Optional forum topic id for digest and announcements
TELEGRAM_GROUP_THREAD_ID=
# Official OpenAI API; use a platform API key (not the CLIProxyAPI key).
# No /v1 suffix: the app appends /v1/chat/completions.
LLM_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-terra
# HTTPS CONNECT through the RU1 sidecar and RU2. TLS terminates at OpenAI.
LLM_PROXY_URL=http://xray:18080
# off | shadow (classify and record, never write reports or send) | live
BOT_MODE=off
DIGEST_WEEKDAY=0
DIGEST_HOUR=20
DIGEST_LLM_COMMENT=0
